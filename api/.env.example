DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suliv?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
# Optional. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
# Server-side only. Never expose this value to the mobile app.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
# Server-side only. Never expose this value to the mobile app.
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Must reference a moderation-enabled Cloudinary upload preset.
CLOUDINARY_UPLOAD_PRESET="your-cloudinary-upload-preset"
# Server-side only. Signs the self-issued admin panel JWT (HS256), isolated
# from the Supabase-issued mobile JWT (RS256/JWKS).
ADMIN_JWT_SECRET="your-admin-jwt-secret"
ADMIN_JWT_EXPIRES_IN="12h"
# Server-side only. Used by the daily vegan recipe import job.
SPOONACULAR_API_KEY="your-spoonacular-api-key"
# Server-side only. Translates imported recipes from English to pt-BR.
# Required in production. Locally you can leave it unset and run
# `ant auth login` instead — the SDK picks up that profile automatically.
ANTHROPIC_API_KEY="your-anthropic-api-key"
