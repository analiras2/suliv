SUPABASE_SERVICE_ROLE_KEY="local-development-only-not-a-real-key"
CLOUDINARY_CLOUD_NAME="local-test"
CLOUDINARY_API_KEY="local-test"
CLOUDINARY_API_SECRET="local-development-only-not-a-real-secret"
CLOUDINARY_UPLOAD_PRESET="local-test"
ADMIN_JWT_SECRET="local-development-only-not-a-real-secret"
ADMIN_JWT_EXPIRES_IN="12h"
SPOONACULAR_API_KEY="local-development-only-not-a-real-key"
