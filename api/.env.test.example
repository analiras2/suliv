# Only Docker Compose's isolated local test database is accepted by the scripts.
DATABASE_URL="postgresql://suliv_test:suliv_test@localhost:54329/suliv_test?schema=public"
ADMIN_JWT_SECRET="suliv-local-test-admin-jwt-secret"

# One of dev | staging | prod. Supplied by the deploy environment, never inferred.
APP_ENV="dev"
# Server-side only. Signs the opaque pagination cursors (HMAC); must match across API instances.
PAGINATION_CURSOR_SECRET="suliv-local-test-pagination-cursor-secret"
