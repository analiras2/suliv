# Base URL of the admin API (Task 1's NestJS server). Server-side only —
# route handlers call this, it is never exposed to the browser.
ADMIN_API_URL="http://localhost:3000"

# Must match api/.env ADMIN_JWT_SECRET. The admin proxy verifies the HttpOnly
# session cookie before allowing dashboard routes.
ADMIN_JWT_SECRET="your-admin-jwt-secret"

# Used only by the Playwright E2E suite (e2e/global-setup.ts) to seed a test
# admin directly in the database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suliv?schema=public"
